{
  "manifest_version": 3,
  "name": "mp-helper 公众号助手",
  "version": "0.1.0",
  "description": "公众号后台助手：一键把排版好的 HTML 存进草稿箱（自动上传图片）、导出发表记录为 JSON",
  "content_scripts": [
    {
      "matches": ["https://mp.weixin.qq.com/cgi-bin/*"],
      "js": ["src/content/main.js"],
      "css": ["src/content/style.css"],
      "run_at": "document_idle"
    }
  ]
}
